{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://c--fe8864a7-395a-41b2-bbcc-de56988a8930-prod.lovable.cloud/auth/v1",
    "resource": "https://c--fe8864a7-395a-41b2-bbcc-de56988a8930-prod.lovable.cloud/functions/v1/mcp",
    "resource_name": "Velmora Home MCP",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "rizwan-furniture-mcp",
      "version": "0.1.0",
      "title": "Velmora Home MCP"
    },
    "tools": [
      {
        "name": "list_categories",
        "title": "List categories",
        "description": "List all furniture categories in the Velmora Home catalog with product counts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "search_products",
        "title": "Search products",
        "description": "Search the Velmora Home catalog by keyword, category, price range, or flags (new, bestSeller, trending). Returns matching products with name, category, price, and product code.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Free-text query matched against name, description, material, finish, color, style, and product code.",
              "type": "string"
            },
            "category": {
              "description": "Category id or slug (e.g. 'beds', 'wardrobes').",
              "type": "string"
            },
            "minPrice": {
              "description": "Minimum price in USD.",
              "type": "number"
            },
            "maxPrice": {
              "description": "Maximum price in USD.",
              "type": "number"
            },
            "onlyNew": {
              "type": "boolean"
            },
            "onlyBestSeller": {
              "type": "boolean"
            },
            "onlyTrending": {
              "type": "boolean"
            },
            "limit": {
              "description": "Max results to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product details",
        "description": "Fetch full details for one product by its slug or product code.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slugOrCode": {
              "type": "string",
              "minLength": 1,
              "description": "The product slug (e.g. 'arc-pendant-light') or productCode."
            }
          },
          "required": [
            "slugOrCode"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_contact_info",
        "title": "Get store contact info",
        "description": "Return the Velmora Home store's phone, WhatsApp, and email contact details.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
